MO_BISTRO_DB=postgres
DATABASE_URL=YOUR_PRODUCTION_NEON_URL
MO_BISTRO_POSTGRES_URL=YOUR_PRODUCTION_NEON_URL
STAFF_SESSION_SECRET=GENERATE_NEW_SECRET
 # WhatsApp: disabled unless explicitly enabled. Apply the notification migration
 # to an ISOLATED Neon branch first; never put Production credentials in tests.
WHATSAPP_ENABLED=false
WHATSAPP_MODE=test
WHATSAPP_ALLOW_LIVE_SEND=false
WHATSAPP_ASSOCIATION_SECRET=
WHATSAPP_CALLBACK_BASE_URL=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_DISPATCH_SECRET=
WHATSAPP_CONFIRMATION_TEMPLATE=
WHATSAPP_ALMOST_READY_TEMPLATE=
WHATSAPP_REVIEW_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=https://qstash.upstash.io

# Advanced Preview only: each feature is OFF unless explicitly enabled.
ADV_WA_WAIT_ESTIMATE=false
ADV_WA_REMINDERS=false
ADV_TABLE_OVERRIDE=false
ADV_TABLE_EDITOR=false
ADV_WA_HISTORY_LIMIT=50
ADV_WA_MIN_SAMPLES=10
ADV_WA_REMINDER_MINUTES=10
ADV_WA_PRE_NOTIFY_MAX_MESSAGES=3
